[Unit]
Description=Deepgram hotkey dictation
Requires=deepgram-dictate.socket
After=deepgram-dictate.socket pipewire.service pipewire-pulse.service

[Service]
ExecStart=%h/.local/bin/dictate daemon
Restart=on-failure
RestartSec=2

[Install]
# Started at login so the first hotkey press is instant; the socket starts it on demand too.
WantedBy=default.target
